<div class="card">
  {% if image %}
    {% if url %}
      <a href="{{ url }}" class="card__image" aria-label="{{ title | default: 'Open project' }}" target="_blank" rel="noopener noreferrer">
        <img src="{{ image }}" alt="{{ imageAlt or title }}">
      </a>
    {% else %}
      <div class="card__image">
        <img src="{{ image }}" alt="{{ imageAlt or title }}">
      </div>
    {% endif %}
  {% endif %}

  {% if title %}
    <div class="card__title">
      <h3>{{ title }}</h3>
    </div>
  {% endif %}

  {% if description %}
    <div class="card__description">
      <p>{{ description }}</p>
    </div>
  {% endif %}
</div>
